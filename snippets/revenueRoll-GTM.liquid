}

var rrPageVisitLimit = 0;   // 0 = interaction (and optional timer) only. Original value was 1 (loaded immediately).
var rrUseTimer = false;     // false = no timer, so the lab test (no scrolling or tapping) never loads GTM. true = also load after loadDelay.
var loadDelay = 5000;       // milliseconds, only used when rrUseTimer = true
var rrFired = false;        // guard so GTM can never load twice

// pageview counter (session)
var rrpvc = 0;
try {
  rrpvc = parseInt(sessionStorage.getItem('rrpvc') || 0, 10) + 1;
  sessionStorage.setItem('rrpvc', rrpvc);
} catch (e) {}

function triggerRR() {
  if (rrFired) return;
  rrFired = true;
  try { sessionStorage.setItem('rrtdl', 'true'); } catch (e) {}
  loadRR();
}

var rrAlready = false;
try { rrAlready = !!sessionStorage.getItem('rrtdl'); } catch (e) {}

if (rrAlready) {
  // Later pages in the same session: load straight away so tracking stays complete
  triggerRR();
} else {
  var pagesReached = (rrPageVisitLimit > 0 && rrpvc >= rrPageVisitLimit);
  if (pagesReached) {
    triggerRR();
  } else {
    if (rrUseTimer) {
      setTimeout(triggerRR, loadDelay);
    }
    ['scroll', 'touchstart', 'keydown', 'mousemove'].forEach(function (ev) {
      window.addEventListener(ev, triggerRR, { once: true, passive: true });
    });
  }
}
</script>
