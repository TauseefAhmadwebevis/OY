{%- liquid
  assign show_selectors = false
  assign currency_selector = false
  assign locale_selector = false

  if section.settings.show_currency_selector and shop.enabled_currencies.size > 1
    assign currency_selector = true
  endif

  if section.settings.show_locale_selector and shop.enabled_locales.size > 1
    assign locale_selector = true
  endif

  if currency_selector or locale_selector
    assign show_selectors = true
  endif
-%}
{% comment %}
  ADA: the toolbars render outside <header>, so each is a labelled region landmark
  (axe "region"). Attributes go on the existing divs to keep the
  `.toolbar + .header-sticky-wrapper` sibling CSS intact.
{% endcomment %}
<div class="toolbar{% if overlay_header%} toolbar--transparent{% endif %} small--hide toolbar--mobile" role="region" aria-label="Announcement">
  <div class="page-width">
    <div class="toolbar__content">
      <div class="toolbar__item" style="width: auto;">
      </div>

      {% if template == 'collection' %}
        {% assign static_text = static_msg_collection_page %}
      {% elsif template contains 'product' %}
        {% assign static_text = static_msg_product_page %}
      {% else %}
        {% assign static_text = static_msg_homepage %}
      {% endif %}
      <div class="toolbar__item" style="width: 100%;">
        <span class="announcement-text">{{ static_text }}</span>
      </div>
      <div class="toolbar__item" style="width: auto;">
        </div>
    </div>
  </div>
</div>
<div class="toolbar{% if overlay_header%} toolbar--transparent{% endif %} small--hide" role="region" aria-label="Store toolbar">
  <div class="page-width">
    <div class="toolbar__content">
      {%- if section.settings.toolbar_menu != blank -%}
        <div class="toolbar__item toolbar__item--menu">
          <ul class="inline-list toolbar__menu">
          {%- for link in toolbar_menu.links -%}
            <li>
              <a href="{{ link.url }}">
               <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-email" viewBox="0 0 64 64"><path d="M63 52H1V12h62zM1 12l25.68 24h9.72L63 12M21.82 31.68L1.56 51.16m60.78.78L41.27 31.68"></path></svg>
              
            {{ link.title }}</a>
            </li>
          {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {% if template == 'collection' %}
        {% assign static_text = static_msg_collection_page %}
      {% elsif template contains 'product' %}
        {% assign static_text = static_msg_product_page %}
      {% else %}
        {% assign static_text = static_msg_homepage %}
      {% endif %}
      <div class="toolbar__item">
        <span class="announcement-text">{{ static_text }}</span>
      </div>

      {%- if section.settings.toolbar_social -%}
        <div class="toolbar__item custom-tool">
          {%- render 'header-icons', section: section -%}
          {% comment %}
          {% render 'social-icons', additional_classes: 'inline-list toolbar__social' %}
        {% endcomment %}
        </div>
      {%- endif -%}

      {%- if show_selectors -%}
        <div class="toolbar__item">
          {%- render 'multi-selectors',
            locale_selector: locale_selector,
            currency_selector: currency_selector,
            show_currency_flags: section.settings.show_currency_flags
            location: 'toolbar'
          -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>
