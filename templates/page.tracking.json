        "template--16739748282596__ed3643b1-7527-4f31-a7f2-4dcf076dd1bd-1687413347f00d8b62-1": {
          "type": "question",
          "settings": {
            "title": "When will my order arrive?",
            "text": "<p>Due to the unpredictable nature of weather, holiday delays, and internal carrier issues, all shipping times are approximate.<br/><br/>United States: Delivered within 1-4 business days<br/>Canada: Delivered within 1-2 weeks<br/>Rest of the World: Delivered within 1-3+ weeks</p>"
          }
        },
        "1645d592-ffb5-4fac-86b4-e794d4591fd8": {
          "type": "question",
          "settings": {
            "title": "When will my order ship?",
            "text": "<p>All orders are processed and complete by 1-3 business days.</p>"
          }
        },
        "bb765fff-4b52-45e1-8899-9888a28a4b0d": {
          "type": "question",
          "settings": {
            "title": "Order is confirmed but there's been no updates",
            "text": "<p>An order is officially confirmed once we print a label for it.<br/><br/>We have scheduled pickups with our local post office in our facility and sometimes when we leave our packages for them they may not update the tracking due to it being either the weekend, a delay due to a higher volume of traffic, local weather conditions, or in the worst case scenario, a lost package. In the last case, we would speedily resolve those issues by sending you a new replacement order immediately. 💚</p>"
          }
        }
