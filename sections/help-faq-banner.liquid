{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign image = section.settings.background_image
-%}

{%- style -%}
  .help-faq-banner--{{ section.id }} {
    --help-faq-banner-height: {{ section.settings.height_mobile }}px;
    {%- if section.settings.background_color != blank %}
      --help-faq-banner-bg: {{ section.settings.background_color }};
    {%- endif %}
    {%- if section.settings.text_color != blank %}
      --help-faq-banner-text: {{ section.settings.text_color }};
    {%- endif %}
    --help-faq-banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  @media only screen and (min-width: 769px) {
    .help-faq-banner--{{ section.id }} {
      --help-faq-banner-height: {{ section.settings.height_desktop }}px;
    }
  }
  .help-faq-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--help-faq-banner-height);
    padding: 40px 17px;
    overflow: hidden;
    text-align: center;
    background-color: var(--help-faq-banner-bg, var(--colorBtnPrimary));
    color: var(--help-faq-banner-text, var(--colorBtnPrimaryText));
  }
  .help-faq-banner--has-image {
    background-color: var(--help-faq-banner-bg, var(--colorLargeImageBg));
    color: var(--help-faq-banner-text, var(--colorHeroText));
  }
  .help-faq-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .help-faq-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--colorImageOverlay);
    opacity: var(--help-faq-banner-overlay);
  }
  .help-faq-banner__heading {
    position: relative;
    margin: 0;
    color: inherit;
  }
{%- endstyle -%}

<div class="help-faq-banner help-faq-banner--{{ section.id }}{% if image != blank %} help-faq-banner--has-image{% endif %}">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 3840
      | image_tag:
        class: 'help-faq-banner__image',
        widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        preload: true,
        alt: ''
    }}
    <div class="help-faq-banner__overlay" aria-hidden="true"></div>
  {%- endif -%}
  <h1 class="help-faq-banner__heading h1">{{ heading | escape }}</h1>
</div>

{% schema %}
{
  "name": "FAQ Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Decorative. Leave empty to use the background color."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs",
      "info": "Page H1. Falls back to the page title when empty."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30,
      "info": "Uses the theme image overlay color."
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height on desktop",
      "min": 160,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height on mobile",
      "min": 120,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "paragraph",
      "content": "Leave colors empty to use the theme colors: button color/text when there is no image, image text color when there is."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "presets": [
    {
      "name": "FAQ Banner"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
