            <img src="{{ section.settings.easter-tees-collection-mobile-banner | img_url:'master' }}" alt="mobile" loading="lazy">
          </div>
        </div>
      {% else %}

        <div class="page-width page-content page-content--top">
          <header class="section-header section-header--flush">
            {%- render 'breadcrumbs' -%}
            <h1 class="section-header__title inuse">
              {{ collection.title }}
            </h1>
          </header>
        </div>
      {% endif %}

    {% elsif collection.handle == "2026-soccer-championship" %}  
      {% if section.settings['soccer-championship-desktop-banner'] != blank or section.settings['soccer-championship-mobile-banner'] != blank %}
        <div class="collection-page-banner">
          <div class="desktop-banner">
            <img src="{{ section.settings.soccer-championship-desktop-banner | img_url:'master' }}" alt="desktop" loading="lazy">
          </div>
          <div class="mobile-banner">
            <img src="{{ section.settings.soccer-championship-mobile-banner | img_url:'master' }}" alt="mobile" loading="lazy">
          </div>
        </div>
      {% else %}

        <div class="page-width page-content page-content--top">
          <header class="section-header section-header--flush">
            {%- render 'breadcrumbs' -%}
            <h1 class="section-header__title inuse">
              {{ collection.title }}
            </h1>
          </header>
        </div>
      {% endif %}

    {% elsif collection.handle contains "soccer-championship-tote-bag" %}  
      {% if section.settings['soccer-championship-tote-bag-desktop-banner'] != blank or section.settings['soccer-championship-tote-bag-mobile-banner'] != blank %}
        <div class="collection-page-banner">
          <div class="desktop-banner">
            <img src="{{ section.settings.soccer-championship-tote-bag-desktop-banner | img_url:'master' }}" alt="desktop" loading="lazy">
          </div>
          <div class="mobile-banner">
            <img src="{{ section.settings.soccer-championship-tote-bag-mobile-banner | img_url:'master' }}" alt="mobile" loading="lazy">
          </div>
        </div>
      {% else %}

        <div class="page-width page-content page-content--top">
          <header class="section-header section-header--flush">
            {%- render 'breadcrumbs' -%}
            <h1 class="section-header__title inuse">
              {{ collection.title }}
            </h1>
          </header>
        </div>
      {% endif %}

    {% elsif collection.handle contains "soccer-championship-t-shirt" %}  
      {% if section.settings['soccer-championship-t-shirt-desktop-banner'] != blank or section.settings['soccer-championship-t-shirt-mobile-banner'] != blank %}
        <div class="collection-page-banner {{collection.title }}">
          <div class="desktop-banner">
            <img src="{{ section.settings.soccer-championship-t-shirt-desktop-banner | img_url:'master' }}" alt="desktop" loading="lazy">
          </div>
          <div class="mobile-banner">
            <img src="{{ section.settings.soccer-championship-t-shirt-mobile-banner | img_url:'master' }}" alt="mobile" loading="lazy">
          </div>
        </div>
      {% else %}

        <div class="page-width page-content page-content--top {{collection.title }}">
          <header class="section-header section-header--flush">
            {%- render 'breadcrumbs' -%}
            <h1 class="section-header__title inuse sd">
              {{ collection.title }}
            </h1>
          </header>
        </div>
      {% endif %}  


    {% else %}
      <div class="page-width page-content page-content--top {{collection.title }}">
        <header class="section-header section-header--flush">
          {%- render 'breadcrumbs' -%}
          <h1 class="section-header__title inuse he">
            {{ collection.title }}
          </h1>
        </header>
      </div>
    {%- endif -%}
    
  {%- endif -%}
{% else %}
  {%- assign disable_sticky_header = true -%}
{%- endif -%}

{%- if disable_sticky_header -%}
  {% comment %}
    Div to trigger theme.CollectionHeader JS
  {% endcomment %}
  <div
    id="CollectionHeaderSection"
    data-section-id="{{ section.id }}"
    data-section-type="collection-header"
  ></div>
{%- endif -%}
