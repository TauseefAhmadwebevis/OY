{{ 'help-shipping.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .help-shipping--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media only screen and (min-width: 769px) {
    .help-shipping--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="help-shipping help-shipping--{{ section.id }} help-shipping--{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="help-shipping__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'intro' -%}
            {%- if block.settings.text != blank -%}
              <div class="help-shipping__block help-shipping__intro rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          {%- when 'content_section' -%}
            <div class="help-shipping__block" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="help-shipping__heading h3">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="rte">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          {%- when 'contact_note' -%}
            {%- if block.settings.text != blank -%}
              <div class="help-shipping__block help-shipping__note rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shipping Content",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Uses the theme colors: body background, or the slightly dimmed body background.",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "subtle", "label": "Subtle" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "paragraph",
      "content": "Mobile padding is 75% of these values."
    }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Introduce this page.</p>"
        }
      ]
    },
    {
      "type": "content_section",
      "name": "Content section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Section heading",
          "info": "Rendered as an H2."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Use this text to share details with your customers.</p>"
        }
      ]
    },
    {
      "type": "contact_note",
      "name": "Contact note",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>For questions and inquiries please contact us.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping Content",
      "blocks": [
        { "type": "intro" },
        { "type": "content_section" },
        { "type": "contact_note" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
